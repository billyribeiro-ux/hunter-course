{
  "name": "contactly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.15 <23",
    "pnpm": ">=10.11"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > src/lib/types/database.types.ts",
    "stripe:listen": "stripe listen --forward-to localhost:5173/api/webhooks/stripe",
    "stripe:seed": "tsx scripts/seed-stripe.ts",
    "seed": "tsx scripts/seed-contacts.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@sveltejs/adapter-vercel": "5.9.0",
    "@sveltejs/kit": "2.55.0",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tailwindcss/vite": "4.2.0",
    "@types/node": "22.15.3",
    "eslint": "9.25.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-svelte": "3.8.0",
    "globals": "15.15.0",
    "prettier": "3.5.3",
    "prettier-plugin-svelte": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.14",
    "supabase": "1.243.0",
    "svelte": "5.28.2",
    "svelte-check": "4.2.1",
    "tailwindcss": "4.2.0",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.30.1",
    "vite": "7.2.4",
    "vitest": "3.1.4"
  },
  "dependencies": {
    "@supabase/ssr": "0.5.3",
    "@supabase/supabase-js": "2.103.2",
    "clsx": "2.1.1",
    "nanoid": "5.0.9",
    "stripe": "22.0.2",
    "tailwind-merge": "2.6.0",
    "zod": "4.3.6"
  }
}
