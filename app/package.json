{
  "name": "contactly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24.16 <25",
    "pnpm": ">=11.5"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > src/lib/types/database.types.ts",
    "stripe:listen": "stripe listen --forward-to localhost:5173/api/webhooks/stripe",
    "stripe:seed": "tsx scripts/seed-stripe.ts",
    "seed": "tsx scripts/seed-contacts.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@sveltejs/adapter-vercel": "6.3.3",
    "@sveltejs/kit": "2.61.1",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "25.9.1",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.18.0",
    "globals": "17.6.0",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "4.0.1",
    "prettier-plugin-tailwindcss": "0.8.0",
    "supabase": "2.102.0",
    "svelte": "5.56.0",
    "svelte-check": "4.4.8",
    "tailwindcss": "4.3.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  },
  "dependencies": {
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.106.2",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.0",
    "clsx": "2.1.1",
    "nanoid": "5.1.11",
    "stripe": "22.2.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  }
}
