# ── Supabase (public, safe to expose) ────────────────────────────────────────
# For local dev these come from `supabase status` after running `supabase start`.
PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.local-anon-key"

# ── Supabase (private, server-only) ──────────────────────────────────────────
# Service role key bypasses RLS. Never expose to the client.
PRIVATE_SUPABASE_SERVICE_ROLE="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.local-service-role-key"

# ── Stripe ──────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/test/apikeys
PRIVATE_STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
# Get from `stripe listen` output or dashboard → Developers → Webhooks
PRIVATE_STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"

# Public, only used for client-side Stripe.js (we don't use it in this course).
PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"

# ── App config ───────────────────────────────────────────────────────────────
PUBLIC_BASE_URL="http://localhost:5173"
